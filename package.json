{
  "name": "facility-booking-backend-system",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "start:prod": "node ./dist/server.js",
    "start:dev": "ts-node-dev --respawn --transpile-only ./src/server.ts",
    "build": "tsc",
    "lint": "npx eslint src --ignore-pattern .ts",
    "lint:fix": "npx eslint src --fix",
    "prettier": "prettier --ignore-path .gitignore --write \"./src/**/*.+(js|ts|json)\"",
    "prettier:fix": "npx prettier --write src",
    "seed": "ts-node-dev --transpile-only ./src/app/db/seed.ts",
    "test": "jest"
  },
  "keywords": [
    "facility-booking",
    "court-booking",
    "express",
    "typescript",
    "mongodb",
    "shurjopay",
    "aamarpay"
  ],
  "author": "Utsho",
  "license": "ISC",
  "description": "Production-grade backend system for sports facility and court booking management with role-based access control, time overlap prevention, and multi-gateway payment processing.",
  "dependencies": {
    "axios": "^1.8.1",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "http-status": "^1.7.4",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3"
  }
}
